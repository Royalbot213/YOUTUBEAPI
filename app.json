{
  "name": "Fresh YouTube API + Telegram Bot",
  "description": "FastAPI YouTube downloader with Telegram API key bot",
  "repository": "https://github.com/Royalbot213/YOUTUBEAPI",
  "keywords": ["python", "fastapi", "youtube", "telegram", "yt-dlp", "ffmpeg"],
  "buildpacks": [
    {"url": "https://github.com/heroku/heroku-buildpack-apt"},
    {"url": "heroku/python"}
  ],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram BotFather bot token",
      "required": true
    },
    "API_KEY_SECRET": {
      "description": "Secret used to generate and verify API keys",
      "generator": "secret",
      "required": true
    },
    "API_BASE_URL": {
      "description": "Public Heroku URL of this application",
      "required": false
    }
  },
  "formation": {
    "web": {"quantity": 1, "size": "basic"},
    "worker": {"quantity": 1, "size": "basic"}
  },
  "success_url": "/health"
}
