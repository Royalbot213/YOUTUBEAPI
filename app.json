{
  "name": "YouTube API India",
  "description": "Fast YouTube API with Telegram bot support",
  "repository": "https://github.com/YOUR_GITHUB_USERNAME/youtubeapi",
  "keywords": [
    "youtube",
    "api",
    "fastapi",
    "telegram",
    "bot"
  ],
  "env": {
    "API_ID": {
      "description": "Telegram API ID from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash from my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Telegram Bot Token from @BotFather",
      "required": true
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
